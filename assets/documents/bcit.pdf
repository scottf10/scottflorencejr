<script language="javascript" type="text/javascript">   

    // all jQuery events are executed within the document ready function
    $(document).ready(function () {
        // following code will bind the keydown event for the current page.
        // In this key down event, [Enter] key code will be detected and accordingly,
        // save, login, continue, yes, next, etc. buttons of that page will be clicked 
        // on pressing [Enter] key 
        $(document).bind("keydown", function (event) {
            // track enter key
            var keycode = (event.keyCode ? event.keyCode : (event.which ? event.which : event.charCode));
            if (keycode == 13 && event.target.nodeName != "TEXTAREA") { // keycode for enter key                                 
                $("input[type='submit']").each(function (index) // looping thru all the submit buttons in the page.
                {
                    var btnValue = $(this).attr('value');    // getting the 'v    alue'(text) attribute of each button.
                    // checking conditions for all possible buttons
                    if (btnValue.toLowerCase().indexOf('login') >= 0 ||
                        btnValue.toLowerCase().indexOf('search') >= 0 ||
                        btnValue.toLowerCase().indexOf('save') >= 0 ||
                        btnValue.toLowerCase().indexOf('next') >= 0 ||
                        btnValue.toLowerCase().indexOf('continue') >= 0 ||
                        btnValue.toLowerCase().indexOf('include selected') >= 0 ||
                        btnValue.toLowerCase().indexOf('yes') >= 0 ||
                        btnValue.toLowerCase().indexOf('send') >= 0 || //&& !$("input[type='submit']").attr("class").indexOf("MessageNewAllRoles")>0)||
                        btnValue.toLowerCase().indexOf('proceed to submit') >= 0 ||
                        btnValue.toLowerCase().indexOf('process payment and submit application') >= 0 ||
                        btnValue.toLowerCase().indexOf('initiate permit request') >= 0 ||
                        btnValue.toLowerCase().indexOf('submit response') >= 0
                    ) {
                        // Incase where 'Search' is shown in a modal popup within the same page and is not hidden
                        //  && !$("input[type='submit'][value='Search']").is(':hidden')
                        if ($("input[type='submit'][value='Search']:visible:enabled").length != 0) {
                            // alert('search block');
                            $("input[type='submit'][value='Search']:visible:enabled").focus();
                            $("input[type='submit'][value='Search']:visible:enabled").click();
                            return false; // here return false is to exit the loop.
                        }
                        else if ($("input[type='submit'][value='Include']:visible:enabled").length != 0) {
                            // alert('search block');
                            $("input[type='submit'][value='Include']:visible:enabled").focus();
                            $("input[type='submit'][value='Include']:visible:enabled").click();
                            return false; // here return false is to exit the loop.
                        }
                        else if ($("input[type='submit'][value='Add']:visible:enabled").length != 0) {
                            // alert('search block');
                            $("input[type='submit'][value='Add']:visible:enabled").focus();
                            $("input[type='submit'][value='Add']:visible:enabled").click();
                            return false; // here return false is to exit the loop.
                        }
                        // Incase where 'Continue' is shown in a modal popup within the same page and is not hidden, along with the 'Continue >>' button on the same page,
                        // then add a bogus stylesheet'clickme' for that button and get that particular object. This way click event of the other visible 'Continue >>' buttons
                        // on that same page will not be triggered.
                        else if (btnValue.toLowerCase().indexOf('continue') >= 0) {
                            //alert('continue block');
                            if ($(".clickme").length != 0 && !$(".clickme").is(':hidden')) {
                                $(".clickme").focus();
                                $(".clickme").click();
                                return false;
                            }
                            else if ($("input[type='submit'][value='Yes']").length != 0 && !$("input[type='submit'][value='Yes']").is(':hidden')) {
                                $("input[type='submit'][value='Yes']").focus();
                                $("input[type='submit'][value='Yes']").click();
                                return false;
                            }
                            else {
                                $(this).focus();
                                $(this).click();
                                return false;

                            }

                        }
                        // Incase where 'Save' is shown in a modal popup within the same page, then add a bogus stylesheet
                        // 'clickme' for that button and get that particular object. This way click event of the other visible 'Save' buttons
                        // on that same page will not be triggered.
                        else if ($("input[type='submit'][value='Save']").length != 0) {

                            if ($("input[type='submit'][value='Yes']").length != 0 && $("input[type='submit'][value='Yes']").is(':visible')) {
                                $("input[type='submit'][value='Yes']").focus();
                                $("input[type='submit'][value='Yes']").click();
                                return false;
                            }
                            else if ($(".clickme").length != 0) {

                                $(".clickme").focus();
                                $(".clickme").click();
                                return false;
                            }
                            else {
                                $("input[type='submit'][value='Save']").focus();
                                $("input[type='submit'][value='Save']").click();
                                return false;
                            }
                            return false;
                        }
                        // Incase where 'Next >>' and 'Save' button are on the same level. Then, if 'Save' exits then click save else
                        // click 'Next >>' button. This scenario is applicable incase of Wizards where there is 'Add New' functionality.            
                        else if (btnValue.toLowerCase().indexOf('next') >= 0) {
                            if ($(".clickme").length != 0 && !$(".clickme").is(':hidden')) {
                                //alert('clickme block');
                                $(".clickme").focus();
                                $(".clickme").click();
                                return false;
                            }
                            else if ($("input[type='submit'][value='Continue']").length != 0 && !$("input[type='submit'][value='Continue']").is(':disabled')) { //alert('continue block');
                                $("input[type='submit'][value='Continue']").focus();
                                $("input[type='submit'][value='Continue']").click();
                                return false;
                            }
                            else if ($("input[type='submit'][value='Proceed to Submit >>']").length != 0 && !$("input[type='submit'][value='Proceed to Submit >>']").is(':disabled')) { //alert('Proceed block');
                                $("input[type='submit'][value='Proceed to Submit >>']").focus();
                                $("input[type='submit'][value='Proceed to Submit >>']").click();
                                return false;
                            }

                            else if ($("input[type='submit'][value='Save']").length != 0 && !$("input[type='submit'][value='Save']").is(':disabled')) {//alert('Save block');
                                $("input[type='submit'][value='Save']").focus();
                                $("input[type='submit'][value='Save']").click();
                                return false;
                            }
                            // else click that same button
                            else {//alert('else block');
                                $(this).focus();
                                $(this).click();
                                return false;
                            }
                        }
                        else {
                            //alert('final else');
                            $(this).focus();
                            $(this).click();
                            return false;
                        }    // end of if else                                                    
                    } // end of checking conditions if
                }); // end of loop
                return false;
            }
            else {
                return true;
            } // end of key code checking condition
        }); // end of function
    }); // end of document ready

</script>

