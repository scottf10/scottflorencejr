        function DisplayHelpDesc(HelpID) {
            window.open(location.protocol + '//' + location.host + "/Certification/wfHelp.aspx?HelpContentPK=" + HelpID, "Help", "scrollbars=yes,resizable=yes,width=800,height=400");
            return false;
        }

        function SetCursor() {
            //alert('set');
            document.body.style.cursor = "wait";
            //return false;
        }

        function ResetCursor() {
            document.body.style.cursor = 'default';
            top.document.body.style.cursor = 'default';
            var leftX = 0;
            var leftY = 0;
            var width = 500;
            var height = 500;
            var cssText = "position:absolute;font-size:12px;background-color:blue;color:blue;left:" + leftX + "px;top:" + leftY + "px;width:" + width + "%;height:" + height + "%;";
            var divElement = document.createElement("div");
            divElement.id = "xProgressId";
            document.body.appendChild(divElement);
            $("#xProgressId").css(cssText);
            jQuery.fx.interval = 500;
            $("#xProgressId").toggle(500);
            $("#xProgressId").remove();
            document.body.style.cursor = 'default';
        }

    </script>

</head>
